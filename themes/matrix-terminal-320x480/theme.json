{
  "format": "libre-panel-theme/1",
  "name": "Matrix Terminal",
  "author": "TURMO-OpenSource",
  "license": "CC0-1.0",
  "description": "Black with phosphor-green mono type, no cards — a terminal window showing the machine's vitals.",
  "display": {
    "model": "turing-3.5",
    "orientation": "portrait",
    "width": 320,
    "height": 480
  },
  "palette": {
    "bg": "#000000",
    "bg2": "#020603",
    "card": "#041007",
    "card2": "#071a0c",
    "edge": "#00ff4122",
    "text": "#00ff41",
    "muted": "#1f9c3a",
    "dim": "#0e5c22",
    "accent": "#00ff41",
    "accent_deep": "#00b32e",
    "violet": "#3aff9e",
    "violet_deep": "#5e2fd0",
    "green": "#00ff41",
    "pink": "#b7ff2b",
    "warn": "#ffb020",
    "crit": "#ff3b5c",
    "line": "#0a3315",
    "track": "#041007",
    "text2": "#dcdce4",
    "text3": "#b8b8c2"
  },
  "font": "builtin:JetBrainsMono-Medium",
  "background": {
    "color": "@bg2",
    "image": null
  },
  "refresh_ms": 1000,
  "animation": {
    "smoothing_ms": 450
  },
  "grid": {
    "columns": 12,
    "rows": 8,
    "gap": 8,
    "margin": 10
  },
  "style": {
    "card": "flat",
    "radius": 0,
    "glow": 0.3,
    "backdrop": "flat",
    "display_font": "builtin:JetBrainsMono-Bold",
    "text_font": "builtin:JetBrainsMono-Medium"
  },
  "widgets": [
    {
      "type": "rect",
      "id": "backdrop",
      "x": 0,
      "y": 0,
      "w": 320,
      "h": 480,
      "color": "@bg2",
      "color2": "@bg",
      "locked": true
    },
    {
      "type": "rect",
      "id": "hdr-line-l",
      "x": 25,
      "y": 14,
      "w": 67,
      "h": 1,
      "color": "@violet",
      "locked": true
    },
    {
      "type": "rect",
      "id": "hdr-line-r",
      "x": 228,
      "y": 14,
      "w": 67,
      "h": 1,
      "color": "@pink",
      "locked": true
    },
    {
      "type": "text",
      "id": "title",
      "x": 160,
      "y": 6,
      "text": "TURMO",
      "font_size": 13,
      "color": "@text",
      "align": "center",
      "letter_spacing": 6.0,
      "font": "builtin:Barlow-SemiBold"
    },
    {
      "type": "text",
      "id": "version",
      "x": 160,
      "y": 20,
      "text": "v0.3.8.1",
      "font_size": 8,
      "color": "@muted",
      "align": "center",
      "letter_spacing": 1.0,
      "font": "builtin:Barlow-Medium"
    },
    {
      "type": "clock",
      "id": "clock",
      "x": 29,
      "y": 28,
      "format": "%H:%M",
      "font_size": 38,
      "color": "@text",
      "font": "builtin:Barlow-Bold"
    },
    {
      "type": "rect",
      "id": "clock-div",
      "x": 144,
      "y": 41,
      "w": 1,
      "h": 22,
      "color": "@line",
      "locked": true
    },
    {
      "type": "icon",
      "id": "date-icon",
      "x": 175,
      "y": 44,
      "icon": "calendar",
      "size": 16,
      "color": "@violet",
      "stroke": 2
    },
    {
      "type": "clock",
      "id": "date",
      "x": 205,
      "y": 45,
      "format": "%a, %b %d, %Y",
      "font_size": 12,
      "color": "@text3",
      "tabular": false,
      "font": "builtin:Barlow-Medium"
    },
    {
      "type": "rect",
      "id": "cpu-card",
      "x": 5,
      "y": 79,
      "w": 310,
      "h": 105,
      "color": "@card",
      "radius": 12,
      "outline": "@edge",
      "locked": true
    },
    {
      "type": "icon",
      "id": "cpu-icon",
      "x": 16,
      "y": 84,
      "icon": "cpu",
      "size": 18,
      "color": "@accent",
      "stroke": 2
    },
    {
      "type": "gauge",
      "id": "cpu-ring",
      "x": 34,
      "y": 83,
      "w": 96,
      "h": 96,
      "sensor": "cpu.load",
      "thickness": 6,
      "color": "@accent",
      "background": "@track",
      "ticks": 0,
      "glow": 0.0,
      "smooth": true,
      "color_rules": [
        {
          "above": 90,
          "color": "@crit"
        }
      ]
    },
    {
      "type": "metric",
      "id": "cpu-val",
      "x": 82,
      "y": 108,
      "sensor": "cpu.load",
      "format": "{value:.0f}%",
      "font_size": 32,
      "color": "@text",
      "align": "center",
      "font": "builtin:Barlow-Bold"
    },
    {
      "type": "text",
      "id": "cpu-loadlbl",
      "x": 82,
      "y": 158,
      "text": "LOAD",
      "font_size": 8,
      "color": "@muted",
      "align": "center",
      "letter_spacing": 1.5,
      "font": "builtin:Barlow-Medium"
    },
    {
      "type": "rect",
      "id": "cpu-div1",
      "x": 144,
      "y": 88,
      "w": 1,
      "h": 86,
      "color": "@line",
      "locked": true
    },
    {
      "type": "icon",
      "id": "cpu-tempicon",
      "x": 189,
      "y": 92,
      "icon": "temperature",
      "size": 24,
      "color": "@accent",
      "stroke": 2
    },
    {
      "type": "metric",
      "id": "cpu-value",
      "x": 214,
      "y": 91,
      "sensor": "cpu.temp",
      "format": "{value:.0f}{unit}",
      "font_size": 22,
      "max_width": 90,
      "color": "@text",
      "align": "left",
      "font": "builtin:Barlow-Bold"
    },
    {
      "type": "rect",
      "id": "cpu-rule",
      "x": 151,
      "y": 128,
      "w": 155,
      "h": 1,
      "color": "@line",
      "locked": true
    },
    {
      "type": "graph",
      "id": "cpu-graph",
      "x": 151,
      "y": 137,
      "w": 155,
      "h": 37,
      "sensor": "cpu.load",
      "history": 120,
      "min": 0,
      "max": 100,
      "color": "@accent",
      "fill": true,
      "fill_fade": true,
      "smooth": true,
      "line_width": 1,
      "grid": 0,
      "glow": 0.2,
      "glow_radius": 3,
      "fill_alpha": 0.22
    },
    {
      "type": "rect",
      "id": "gpu-card",
      "x": 5,

{
  "format": "libre-panel-theme/1",
  "name": "Custom Blank Canvas",
  "author": "TURMO-OpenSource",
  "license": "CC0-1.0",
  "description": "An empty canvas: just a clock and a hint. The starting point for your own layout.",
  "display": {
    "model": "turing-3.5",
    "orientation": "landscape",
    "width": 480,
    "height": 320
  },
  "palette": {
    "bg": "#000000",
    "bg2": "#0a0a0f",
    "card": "#14141a",
    "card2": "#1d1d26",
    "edge": "#2a2a35",
    "text": "#f2f2f7",
    "muted": "#9a9aa6",
    "dim": "#5c5c68",
    "accent": "#00e5ff",
    "accent_deep": "#0091b8",
    "violet": "#7c4dff",
    "violet_deep": "#5e2fd0",
    "green": "#00ff9d",
    "pink": "#ff2bd6",
    "warn": "#ffb020",
    "crit": "#ff3b5c",
    "line": "#2a2a35",
    "track": "#1d1d26",
    "text2": "#dcdce4",
    "text3": "#b8b8c2"
  },
  "font": "builtin:Barlow-Medium",
  "background": {
    "color": "@bg2",
    "image": null
  },
  "refresh_ms": 1000,
  "animation": {
    "smoothing_ms": 450
  },
  "grid": {
    "columns": 12,
    "rows": 8,
    "gap": 8,
    "margin": 10
  },
  "style": {
    "card": "flat",
    "radius": 10,
    "glow": 0.2,
    "backdrop": "flat",
    "display_font": "builtin:Barlow-Bold",
    "text_font": "builtin:Barlow-Medium"
  },
  "widgets": [
    {
      "type": "rect",
      "id": "backdrop",
      "x": 0,
      "y": 0,
      "w": 480,
      "h": 320,
      "color": "@bg2",
      "color2": "@bg",
      "locked": true
    },
    {
      "type": "clock",
      "id": "clock",
      "x": 16,
      "y": 10,
      "format": "%H:%M",
      "font_size": 52,
      "color": "@text",
      "font": "builtin:Barlow-Bold",
      "finish": "lit"
    },
    {
      "type": "clock",
      "id": "date",
      "x": 18,
      "y": 70,
      "format": "%A, %d %B",
      "font_size": 16,
      "color": "@muted",
      "finish": "lit"
    },
    {
      "type": "text",
      "id": "hint",
      "x": 16,
      "y": 290,
      "w": 448,
      "h": 18,
      "text": "EDIT ME IN THE THEME EDITOR",
      "font_size": 11,
      "color": "@dim",
      "align": "left",
      "letter_spacing": 1.2,
      "finish": "lit"
    }
  ]
}

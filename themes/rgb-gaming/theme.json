    },
    {
      "type": "rect",
      "id": "ram-div",
      "x": 334,
      "y": 210,
      "w": 126,
      "h": 1,
      "color": "@line",
      "locked": true
    },
    {
      "type": "metric",
      "id": "ram-temp",
      "x": 334,
      "y": 222,
      "sensor": "mem.used",
      "format": "{value:.1f} GB",
      "font_size": 22,
      "color": "@text",
      "align": "left",
      "font": "builtin:Barlow-Bold"
    },
    {
      "type": "text",
      "id": "ram-templbl",
      "x": 334,
      "y": 252,
      "text": "USED",
      "font_size": 9,
      "color": "@muted",

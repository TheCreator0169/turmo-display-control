{
  "format": "libre-panel-theme/1",
  "name": "RGB Gaming",
  "author": "TURMO-OpenSource",
  "license": "CC0-1.0",
  "description": "Dark chassis, vivid multi-colour accents (cyan/violet/green/pink) and strong glow — the RGB rig look.",
  "display": {
    "model": "turing-3.5",
    "orientation": "landscape",
    "width": 480,
    "height": 320
  },
  "palette": {
    "bg": "#050508",
    "bg2": "#0b0b12",
    "card": "#131320",
    "card2": "#1c1c2e",
    "edge": "#2e2e46",
    "text": "#f4f4fa",
    "muted": "#a0a0b4",
    "dim": "#5c5c68",
    "accent": "#00e5ff",
    "accent_deep": "#0091b8",
    "violet": "#8b5cf6",
    "violet_deep": "#5e2fd0",
    "green": "#00ff9d",
    "pink": "#ff2bd6",
    "warn": "#ffb020",
    "crit": "#ff3b5c",
    "line": "#23233a",
    "track": "#1c1c2e",
    "text2": "#dcdce4",
    "text3": "#b8b8c2"
  },
  "font": "builtin:Barlow-Medium",
  "background": {
    "color": "@bg2",
    "image": null
  },
  "refresh_ms": 1000,
  "animation": {
    "smoothing_ms": 450
  },
  "grid": {
    "columns": 12,
    "rows": 8,
    "gap": 8,
    "margin": 10
  },
  "style": {
    "card": "outline",
    "radius": 12,
    "glow": 0.7,
    "backdrop": "flat",
    "display_font": "builtin:Barlow-Bold",
    "text_font": "builtin:Barlow-Medium"
  },
  "widgets": [
    {
      "type": "rect",
      "id": "backdrop",
      "x": 0,
      "y": 0,
      "w": 480,
      "h": 320,
      "color": "@bg2",
      "color2": "@bg",
      "locked": true
    },
    {
      "type": "text",
      "id": "title",
      "x": 16,
      "y": 8,
      "text": "TURMO",
      "font_size": 12,
      "color": "@text",
      "align": "left",
      "letter_spacing": 4.0,
      "font": "builtin:Barlow-SemiBold"
    },
    {
      "type": "clock",
      "id": "clock",
      "x": 14,
      "y": 22,
      "format": "%H:%M",
      "font_size": 30,
      "color": "@text",
      "font": "builtin:Barlow-Bold"
    },
    {
      "type": "rect",
      "id": "clock-div",
      "x": 118,
      "y": 28,
      "w": 1,
      "h": 34,
      "color": "@line",
      "locked": true
    },
    {
      "type": "clock",
      "id": "date",
      "x": 130,
      "y": 36,
      "format": "%a %d %b",
      "font_size": 12,
      "color": "@muted",
      "tabular": false
    },
    {
      "type": "text",
      "id": "net-uplbl",
      "x": 300,
      "y": 12,
      "text": "UP",
      "font_size": 8,
      "color": "@muted",
      "letter_spacing": 1.5
    },
    {
      "type": "metric",
      "id": "net-up",
      "x": 332,
      "y": 9,
      "sensor": "net.up",
      "format": "{value:rate} {value:rate_unit}",
      "font_size": 12,
      "color": "@accent",
      "align": "left",
      "font": "builtin:Barlow-SemiBold",
      "tabular": true
    },
    {
      "type": "text",
      "id": "net-dnlbl",
      "x": 300,
      "y": 30,
      "text": "DOWN",
      "font_size": 8,
      "color": "@muted",
      "letter_spacing": 1.5
    },
    {
      "type": "metric",
      "id": "net-down",
      "x": 332,
      "y": 27,
      "sensor": "net.down",
      "format": "{value:rate} {value:rate_unit}",
      "font_size": 12,
      "color": "@green",
      "align": "left",
      "font": "builtin:Barlow-SemiBold",
      "tabular": true
    },
    {
      "type": "rect",
      "id": "top-line",
      "x": 8,
      "y": 56,
      "w": 464,
      "h": 1,
      "color": "@line",
      "locked": true
    },
    {
      "type": "rect",
      "id": "cpu-card",
      "x": 8,
      "y": 66,
      "w": 150,
      "h": 240,
      "color": "@card",
      "radius": 12,
      "outline": "@edge",
      "locked": true
    },
    {
      "type": "icon",
      "id": "cpu-icon",
      "x": 20,
      "y": 78,
      "icon": "cpu",
      "size": 22,
      "color": "@accent",
      "stroke": 2
    },
    {
      "type": "text",
      "id": "cpu-title",
      "x": 50,
      "y": 78,
      "text": "CPU",
      "font_size": 16,
      "color": "@text",
      "font": "builtin:Barlow-Bold"
    },
    {
      "type": "text",
      "id": "cpu-sub",
      "x": 50,
      "y": 100,
      "text": "Processor",
      "font_size": 9,
      "color": "@muted"
    },
    {
      "type": "gauge",
      "id": "cpu-ring",
      "x": 47,
      "y": 124,
      "w": 72,
      "h": 72,
      "sensor": "cpu.load",
      "thickness": 7,
      "color": "@accent",
      "background": "@line",
      "ticks": 0,
      "glow": 0.4,
      "glow_radius": 5,
      "smooth": true,
      "color_rules": [
        {
          "above": 90,
          "color": "@crit"
        }
      ]
    },
    {
      "type": "metric",
      "id": "cpu-val",
      "x": 83,
      "y": 146,
      "sensor": "cpu.load",
      "format": "{value:.0f}%",
      "font_size": 15,
      "color": "@text",
      "align": "center",
      "font": "builtin:Barlow-Bold"
    },
    {
      "type": "text",
      "id": "cpu-loadlbl",
      "x": 83,
      "y": 166,
      "text": "LOAD",
      "font_size": 9,
      "color": "@muted",
      "align": "center",
      "letter_spacing": 1.5
    },
    {
      "type": "rect",
      "id": "cpu-div",
      "x": 20,
      "y": 210,
      "w": 126,
      "h": 1,
      "color": "@line",
      "locked": true
    },
    {
      "type": "metric",
      "id": "cpu-temp",
      "x": 20,
      "y": 222,
      "sensor": "cpu.temp",
      "format": "{value:.0f}°",
      "font_size": 22,
      "color": "@text",
      "align": "left",
      "font": "builtin:Barlow-Bold"
    },
    {
      "type": "text",
      "id": "cpu-templbl",
      "x": 20,
      "y": 252,
      "text": "TEMP",
      "font_size": 9,
      "color": "@muted",
      "letter_spacing": 1.5
    },
    {
      "type": "graph",
      "id": "cpu-graph",
      "x": 18,
      "y": 270,
      "w": 130,
      "h": 28,
      "sensor": "cpu.load",
      "history": 120,
      "min": 0,
      "max": 100,
      "color": "@accent",
      "fill": true,
      "fill_fade": true,
      "smooth": true,
      "line_width": 1,
      "grid": 0,
      "glow": 0.2,
      "glow_radius": 3,
      "fill_alpha": 0.22
    },
    {
      "type": "rect",
      "id": "gpu-card",
      "x": 165,
      "y": 66,
      "w": 150,
      "h": 240,
      "color": "@card",
      "radius": 12,
      "outline": "@edge",
      "locked": true
    },
    {
      "type": "icon",
      "id": "gpu-icon",
      "x": 177,
      "y": 78,
      "icon": "gpu",
      "size": 22,
      "color": "@green",
      "stroke": 2
    },
    {
      "type": "text",
      "id": "gpu-title",
      "x": 207,
      "y": 78,
      "text": "GPU",
      "font_size": 16,
      "color": "@text",
      "font": "builtin:Barlow-Bold"
    },
    {
      "type": "text",
      "id": "gpu-sub",
      "x": 207,
      "y": 100,
      "text": "Graphics",
      "font_size": 9,
      "color": "@muted"
    },
    {
      "type": "gauge",
      "id": "gpu-ring",
      "x": 204,
      "y": 124,
      "w": 72,
      "h": 72,
      "sensor": "gpu.load",
      "thickness": 7,
      "color": "@green",
      "background": "@line",
      "ticks": 0,
      "glow": 0.4,
      "glow_radius": 5,
      "smooth": true,
      "color_rules": [
        {
          "above": 90,
          "color": "@crit"
        }
      ]
    },
    {
      "type": "metric",
      "id": "gpu-val",
      "x": 240,
      "y": 146,
      "sensor": "gpu.load",
      "format": "{value:.0f}%",
      "font_size": 15,
      "color": "@text",
      "align": "center",
      "font": "builtin:Barlow-Bold"
    },
    {
      "type": "text",
      "id": "gpu-loadlbl",
      "x": 240,
      "y": 166,
      "text": "LOAD",
      "font_size": 9,
      "color": "@muted",
      "align": "center",
      "letter_spacing": 1.5
    },
    {
      "type": "rect",
      "id": "gpu-div",
      "x": 177,
      "y": 210,
      "w": 126,
      "h": 1,
      "color": "@line",
      "locked": true
    },
    {
      "type": "metric",
      "id": "gpu-temp",
      "x": 177,
      "y": 222,
      "sensor": "gpu.temp",
      "format": "{value:.0f}°",
      "font_size": 22,
      "color": "@text",
      "align": "left",
      "font": "builtin:Barlow-Bold"
    },
    {
      "type": "text",
      "id": "gpu-templbl",
      "x": 177,
      "y": 252,
      "text": "TEMP",
      "font_size": 9,
      "color": "@muted",
      "letter_spacing": 1.5
    },
    {
      "type": "graph",
      "id": "gpu-graph",
      "x": 175,
      "y": 270,
      "w": 130,
      "h": 28,
      "sensor": "gpu.load",
      "history": 120,
      "min": 0,
      "max": 100,
      "color": "@green",
      "fill": true,
      "fill_fade": true,
      "smooth": true,
      "line_width": 1,
      "grid": 0,
      "glow": 0.2,
      "glow_radius": 3,
      "fill_alpha": 0.22
    },
    {
      "type": "rect",
      "id": "ram-card",
      "x": 322,
      "y": 66,
      "w": 150,
      "h": 240,
      "color": "@card",
      "radius": 12,
      "outline": "@edge",
      "locked": true
    },
    {
      "type": "icon",
      "id": "ram-icon",
      "x": 334,
      "y": 78,
      "icon": "ram",
      "size": 22,
      "color": "@violet",
      "stroke": 2
    },
    {
      "type": "text",
      "id": "ram-title",
      "x": 364,
      "y": 78,
      "text": "RAM",
      "font_size": 16,
      "color": "@text",
      "font": "builtin:Barlow-Bold"
    },
    {
      "type": "text",
      "id": "ram-sub",
      "x": 364,
      "y": 100,
      "text": "Memory",
      "font_size": 9,
      "color": "@muted"
    },
    {
      "type": "gauge",
      "id": "ram-ring",
      "x": 361,
      "y": 124,
      "w": 72,
      "h": 72,
      "sensor": "mem.load",
      "thickness": 7,
      "color": "@violet",
      "background": "@line",
      "ticks": 0,
      "glow": 0.4,
      "glow_radius": 5,
      "smooth": true,
      "color_rules": [
        {
          "above": 90,
          "color": "@crit"
        }
      ]
    },
    {
      "type": "metric",
      "id": "ram-val",
      "x": 397,
